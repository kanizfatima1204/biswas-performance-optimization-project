{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "chmod -R ug+rwX bootstrap/cache storage && npm run build"
  },
  "deploy": {
    "preDeployCommand": ["php railway/migrate.php"],
    "healthcheckPath": "/up",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
